PORT=4000
BASE_URL=https://your-domain-or-ngrok-url.example

SESSION_SECRET=change-this-to-random-string

# SMTP settings for password reset email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Road Test <no-reply@example.com>

# Payment card shown to users
CARD_NUMBER=8600 xxxx xxxx xxxx

# App connection string for local PostgreSQL
DATABASE_URL=postgresql:///avtotest

# Bunny Stream
BUNNY_LIBRARY_ID=682999
BUNNY_CDN_HOSTNAME=vz-93c02822-03b.b-cdn.net
BUNNY_API_KEY=replace-with-real-key
BUNNY_API_BASE_URL=https://video.bunnycdn.com

# Telegramning rasmiy xizmatlari orqali kirish (mobil ilova)
# 1) Kod (SMS o'rniga Telegramdan): gateway.telegram.org akkauntingizdagi access token
TELEGRAM_GATEWAY_TOKEN=
# 2) "Telegram orqali kirish" (OpenID Connect): BotFather > bot > Login Widget'dagi Client ID/Secret.
#    Redirect manzilini (quyidagi) BotFather'da "Allowed URLs"ga qo'shing.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://api.topshirdi.uz/api/auth/telegram/oidc/callback
